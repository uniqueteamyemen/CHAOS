{
  "contract_id": "CHAOS-P2-A-MC-STRATIFIED-V1",
  "version": "1.0.0",
  "status": "screening_implementation_pending_full_github_evaluation_and_review",
  "scope": {
    "only_step": "Mc(t,region) stratified screening and threshold sensitivity",
    "stratification": [
      "belt",
      "mag_source",
      "mag_type",
      "five_year_utc_window"
    ],
    "time_window_years": 5,
    "time_window_policy": "fixed_non_overlapping_utc_year_windows_from_1980_through_2024",
    "magnitude_scales_are_not_pooled": true,
    "mag_source_and_mag_type_must_not_be_pooled": true,
    "no_pooled_fallback_for_sparse_strata": true
  },
  "inputs": {
    "source_run_id": 45244943216,
    "source_artifact_id": 14863135742,
    "source_artifact_sha256": "5f5b0c571c1423caef4cfc9001271c8bea261f1b89e2ba0a341f733f677ed683",
    "provenance_run_id": 45421531702,
    "provenance_artifact_id": 14934058860,
    "provenance_artifact_sha256": "7b0fa5105c763b7ec917acacec4866457d8f96164ea3632712dea9edbd4e9467",
    "verify_archive_sha256": true,
    "verify_each_source_catalog_sha256": true,
    "verify_each_provenance_csv_sha256": true,
    "require_one_to_one_event_id_join": true,
    "config_files_read_directly_as_json": [
      "real_data_stress_pipeline/config/seismic_belts.json",
      "real_data_stress_pipeline/config/pipeline.json"
    ],
    "forbid_importing_run_pipeline": true
  },
  "estimator": {
    "methods": [
      "maximum_curvature",
      "gutenberg_richter_goodness_of_fit_90_percent"
    ],
    "magnitude_bin_width": 0.1,
    "minimum_events_for_point_estimate": 50,
    "gft_acceptance_percent": 90,
    "combine_estimates": "max(MAXC, lowest GFT candidate passing 90 percent)",
    "uncertainty_intervals": "not_claimed_in_this_screening_step",
    "point_estimates_require_review": true,
    "minimum_gft_axis_bins": 4,
    "magnitude_rounding": "decimal ROUND_HALF_UP to one decimal place"
  },
  "query_truncation": {
    "catalog_minimum_magnitude": 4.5,
    "minimum_magnitude_is_not_mc": true,
    "mc_below_4_5_estimable": false,
    "boundary_estimate_status": "LEFT_TRUNCATED_AT_QUERY_FLOOR",
    "threshold_sensitivity": [
      4.5,
      5,
      5.5,
      6
    ],
    "sensitivity_method": "count retention and gate against the unfiltered accepted-catalog point estimate; do not re-estimate Mc after artificial threshold truncation"
  },
  "known_exclusions": [
    {
      "event_id": "nc21364840",
      "associated_merged_event_id": "nc40157006",
      "disposition": "EXCLUDED_UPSTREAM_COMCAT_INDEX_MISMATCH",
      "re_fetch": false,
      "included_in_accepted_catalog": false,
      "included_in_mc_calculation": false,
      "handling": "document_only"
    }
  ],
  "explicit_non_goals": [
    "Zaliapin_Ben_Zion_randomization",
    "N1_inhomogeneous_Poisson_fit",
    "N2_Hawkes_ETAS_fit",
    "detector_execution_or_modification",
    "BreakDetectorV1_modification",
    "experiments_tree_modification",
    "Research_Ledger_write"
  ],
  "outputs": {
    "complete_json": "artifacts/p2_a/mc_assessment/P2_A_MC_STRATIFIED_RESULTS.json",
    "print_complete_json_to_stdout": true,
    "append_complete_json_to_github_step_summary": true,
    "workflow_artifact_retention_days": 90,
    "omit_duplicate_input_archives_from_result_artifact": true
  },
  "immutability": {
    "experiments_tree_read_only": true,
    "BreakDetectorV1_read_only": true,
    "historical_p2_2_outputs_read_only": true,
    "governance_ledger_read_only": true,
    "all_new_code_outside_real_data_stress_pipeline": true
  },
  "event_weighted_reporting": {
    "mc_status_rollup": "per belt and overall; event counts and percentages, not only stratum counts",
    "actual_statuses": [
      "ESTIMATED_PENDING_REVIEW",
      "ESTIMATED_LEFT_TRUNCATION_BOUNDARY",
      "GFT_NOT_PASSED",
      "INSUFFICIENT_EVENTS",
      "INSUFFICIENT_MAGNITUDE_RESOLUTION"
    ],
    "status_note": "INSUFFICIENT_MAGNITUDE_RESOLUTION remains separate because its cause is not a low event count; it must not be relabeled as INSUFFICIENT_EVENTS.",
    "threshold_gate_rollup": "event counts and percentages per threshold gate at each of 4.5, 5.0, 5.5, 6.0",
    "top_strata": [
      "top 10 by event count per belt",
      "largest GFT_NOT_PASSED strata per belt",
      "largest strata with estimated Mc above 4.5 per belt"
    ],
    "output_in_stdout_and_github_step_summary": true
  }
}
