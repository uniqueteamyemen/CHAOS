{
  "campaign": "historical-cross-domain-acquisition",
  "window": {
    "start": "2000-01-01",
    "end": "2025-12-31",
    "target_years": 25,
    "timezone": "UTC"
  },
  "policy": {
    "raw_immutable": true,
    "no_raw_imputation": true,
    "no_forced_source_reconciliation": true,
    "preserve_native_frequency": true,
    "monthly_alignment_is_derived_only": true,
    "provenance_required": true
  },
  "sources": [
    {
      "id": "world_bank_wdi",
      "name": "World Bank World Development Indicators",
      "domain": "macro_economy_development",
      "access": "public_api",
      "endpoint": "https://api.worldbank.org/v2/",
      "documentation": "https://datahelpdesk.worldbank.org/knowledgebase/articles/889392-about-the-indicators-api-documentation",
      "native_formats": ["json", "xml"],
      "target_collection": "metadata_and_selected_indicators",
      "credentials": "none_known"
    },
    {
      "id": "fred",
      "name": "Federal Reserve Economic Data",
      "domain": "macro_finance_prices_markets",
      "access": "api_key_required",
      "endpoint": "https://api.stlouisfed.org/fred/",
      "documentation": "https://fred.stlouisfed.org/docs/api/fred/",
      "native_formats": ["json", "xml"],
      "target_collection": "metadata_only_until_key_available",
      "credentials": "user_key_required",
      "vintage_source": "https://alfred.stlouisfed.org/"
    },
    {
      "id": "imf_data",
      "name": "International Monetary Fund Data",
      "domain": "macro_economy_external_accounts",
      "access": "sdmx_api",
      "endpoint": "https://api.imf.org/external/sdmx/2.1/",
      "documentation": "https://data.imf.org/en/Resource-Pages/IMF-API",
      "native_formats": ["sdmx_json", "csv", "xml"],
      "target_collection": "catalog_metadata_first",
      "credentials": "portal_dependent"
    },
    {
      "id": "un_comtrade",
      "name": "UN Comtrade",
      "domain": "international_trade",
      "access": "api_and_bulk",
      "endpoint": "https://comtradeapi.un.org/public/v1/preview/",
      "documentation": "https://comtradedeveloper.un.org/",
      "native_formats": ["json", "csv", "zip"],
      "target_collection": "metadata_and_bounded_trade_extract",
      "credentials": "plan_dependent"
    },
    {
      "id": "noaa_ncei",
      "name": "NOAA National Centers for Environmental Information",
      "domain": "weather_climate_environment",
      "access": "public_api_with_dataset_limits",
      "endpoint": "https://www.ncei.noaa.gov/access/services/data/v1",
      "documentation": "https://www.ncei.noaa.gov/support/access-data-service-api-user-documentation",
      "native_formats": ["csv", "json", "netcdf"],
      "target_collection": "metadata_and_bounded_station_extract",
      "credentials": "dataset_dependent"
    },
    {
      "id": "usgs_water",
      "name": "USGS Water Data APIs",
      "domain": "water_flood_environment",
      "access": "public_ogc_api",
      "endpoint": "https://api.waterdata.usgs.gov/ogcapi/v0/",
      "documentation": "https://api.waterdata.usgs.gov/",
      "native_formats": ["json", "csv"],
      "target_collection": "catalog_and_bounded_series_extract",
      "credentials": "none_known"
    },
    {
      "id": "eia",
      "name": "U.S. Energy Information Administration",
      "domain": "energy_commodities",
      "access": "api_key_required",
      "endpoint": "https://api.eia.gov/v2/",
      "documentation": "https://www.eia.gov/opendata/documentation.php",
      "native_formats": ["json"],
      "target_collection": "metadata_only_until_key_available",
      "credentials": "free_key_required"
    },
    {
      "id": "gdelt",
      "name": "GDELT Project",
      "domain": "global_events_news_collective_behavior",
      "access": "open_download_and_bigquery",
      "endpoint": "https://data.gdeltproject.org/",
      "documentation": "https://gdeltproject.org/",
      "native_formats": ["csv", "zip", "json"],
      "target_collection": "bounded_event_metadata_and_records",
      "credentials": "none_known"
    },
    {
      "id": "acled",
      "name": "Armed Conflict Location & Event Data",
      "domain": "political_violence_conflict",
      "access": "restricted_api",
      "endpoint": "https://api.acleddata.com/acled/read",
      "documentation": "https://acleddata.com/acled-api-documentation",
      "native_formats": ["json", "csv"],
      "target_collection": "metadata_only_until_credentials_available",
      "credentials": "account_or_token_required"
    },
    {
      "id": "ucdp",
      "name": "Uppsala Conflict Data Program",
      "domain": "organized_violence_conflict",
      "access": "versioned_api_token",
      "endpoint": "https://ucdpapi.pcr.uu.se/api/",
      "documentation": "https://ucdp.uu.se/apidocs/",
      "native_formats": ["json", "csv"],
      "target_collection": "versioned_bounded_event_extract",
      "credentials": "token_request_required"
    },
    {
      "id": "nasa_firms",
      "name": "NASA FIRMS",
      "domain": "wildfire_environment",
      "access": "earthdata_archive",
      "endpoint": "https://firms.modaps.eosdis.nasa.gov/",
      "documentation": "https://firms.modaps.eosdis.nasa.gov/active_fire/",
      "native_formats": ["csv", "json", "shp"],
      "target_collection": "science_quality_archive_extract",
      "credentials": "earthdata_login_for_archive"
    },
    {
      "id": "emdat",
      "name": "EM-DAT International Disaster Database",
      "domain": "disaster_impacts",
      "access": "public_portal_registration",
      "endpoint": "https://public.emdat.be/",
      "documentation": "https://doc.emdat.be/",
      "native_formats": ["csv", "xlsx"],
      "target_collection": "catalog_only_until_access_confirmed",
      "credentials": "account_required"
    }
  ]
}
