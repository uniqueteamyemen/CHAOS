{
  "contract_id": "CHAOS_WEO_GDP_GROWTH_VINTAGE_AUDIT_V1",
  "purpose": "Test revision sensitivity of the 2020 IMF real GDP growth signal across official WEO release vintages.",
  "subject_code": "NGDP_RPCH",
  "years": [
    2016,
    2017,
    2018,
    2019,
    2020
  ],
  "event_year": 2020,
  "pretrend_years": [
    2016,
    2017,
    2018,
    2019
  ],
  "method": "Theil-Sen line fitted on the four pre-event years and extrapolated one year to 2020; descriptive vintage sensitivity only.",
  "vintages": [
    {
      "vintage_id": "WEO_2020_OCT",
      "release_label": "October 2020",
      "release_page": "https://www.imf.org/en/publications/weo/weo-database/2020/october",
      "download_url_candidates": [
        "https://www.imf.org/-/media/Files/Publications/WEO/WEO-Database/2020/02/WEOOct2020all.xls",
        "https://www.imf.org/-/media/files/publications/weo/weo-database/2020/02/weooct2020all.xls"
      ],
      "publication_year": 2020,
      "publication_release": "Fall"
    },
    {
      "vintage_id": "WEO_2021_APR",
      "release_label": "April 2021",
      "release_page": "https://www.imf.org/en/publications/weo/weo-database/2021/april",
      "download_url_candidates": [
        "https://www.imf.org/-/media/Files/Publications/WEO/WEO-Database/2021/WEOApr2021all.xls",
        "https://www.imf.org/-/media/files/publications/weo/weo-database/2021/weoapr2021all.xls"
      ],
      "publication_year": 2021,
      "publication_release": "Spring"
    },
    {
      "vintage_id": "WEO_APR2026_PANEL_STAGED",
      "release_label": "April 2026 WEO panel already committed in CHAOS",
      "panel_column": "imf__NGDP_RPCH"
    }
  ],
  "policy": {
    "matching": "ISO-3 exact only",
    "preserve_raw_source_files": true,
    "calculate_raw_sha256": true,
    "classify_2020_using_imf_estimates_start_after": true,
    "estimates_start_after_semantics": "Latest actual-data year; 0 means all years are estimates; 2020 is actual only when latest actual year is >= 2020.",
    "no_missing_value_imputation": true,
    "no_country_name_fuzzy_matching": true,
    "no_inferential_p_values": true,
    "no_causal_claims": true,
    "no_forecasting": true
  },
  "mirror": {
    "repository_id": "econdataverse/imfweo",
    "repository_url": "https://huggingface.co/datasets/econdataverse/imfweo",
    "maintainer_project_url": "https://teal-insights.github.io/r-imfweo/",
    "fallback_policy": "USE_ONLY_AFTER_OFFICIAL_IMF_DOWNLOAD_ACCESS_FAILURE",
    "data_lineage": "Third-party long-form Parquet conversion of published IMF WEO vintages maintained by the imfweo project.",
    "known_missing_metadata": [
      "IMF Estimates Start After",
      "Country/Series-specific Notes",
      "raw original WEO row formatting"
    ],
    "consequences": [
      "Actual/estimate status for mirror rows remains UNKNOWN_MIRROR_METADATA_NOT_PRESERVED.",
      "The mirror must not be described as an official IMF-hosted download.",
      "The mirror revision and every downloaded Parquet shard must be SHA-256 hashed."
    ]
  }
}
